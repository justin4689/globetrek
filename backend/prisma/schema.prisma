generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Category {
  Beach
  Mountain
  Lake
  Desert
  Forest
  City
}

enum ReservationStatus {
  upcoming
  completed
  cancelled
}

enum PaymentStatus {
  deposit_paid
  refunded
  non_refundable
}

enum NotificationType {
  reservation_confirmed
  reservation_cancelled
  payment_successful
  payment_failed
  rate_booking
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  password        String
  phone           String    @default("")
  countryCode     String    @default("+225")
  location        String    @default("")
  avatar          String    @default("") @db.VarChar(512)
  isEmailVerified Boolean   @default(false)
  otp             String?
  otpExpiry       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  favorites     Favorite[]
  reservations  Reservation[]
  notifications Notification[]
  sessions      Session[]
}

// One row per signed-in device: logging in elsewhere no longer signs the other devices out
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @db.VarChar(64) // sha256 of the current refresh token (rotated on refresh)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@index([userId])
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  country     String
  category    Category
  price       Float
  rating      Float
  images      Json
  description String   @db.Text
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews      Review[]
  favorites    Favorite[]
  reservations Reservation[]
}

model Review {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  avatar        String      @default("")
  rating        Float
  text          String      @db.Text

  @@index([destinationId])
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, destinationId])
  @@index([destinationId])
}

model Reservation {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId   String
  destination     Destination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationName String
  country         String
  checkIn         DateTime
  checkOut        DateTime
  guests          Int
  price           Float
  status          ReservationStatus @default(upcoming)
  depositAmount   Float
  balanceDue      Float
  paymentIntentId String?           @unique
  paymentStatus   PaymentStatus     @default(deposit_paid)
  bookingRef      String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  notifications Notification[]

  @@index([userId])
  @@index([destinationId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  subtitle      String
  destination   String?
  checkIn       String?
  checkOut      String?
  amount        Float?
  reason        String?          @db.Text
  detailReason  String?          @db.Text
  isRead        Boolean          @default(false)
  // Reservation this notification is about (kept null if the reservation is deleted)
  reservationId String?
  reservation   Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([reservationId])
}
