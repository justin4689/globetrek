# API base URL. Optional in development: the app then uses the machine running Metro, port 5001.
# Set it to reach another server (staging, production), e.g. https://api.example.com/api
# EXPO_PUBLIC_API_URL=

# Stripe publishable key (test mode): Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
